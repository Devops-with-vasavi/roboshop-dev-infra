# Local .terraform directories
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*

# Crash log files
crash.log

# Exclude override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Exclude plan files
*.tfplan

# Exclude CLI configuration files
.terraformrc
terraform.rc

# Sensitive variable files (often contain secrets)
*.tfvars
*.tfvars.json

# Lock file (optional, depends on team workflow)
.terraform.lock.hcl

